---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Emphasis from '../components/Emphasis.astro';
import profile from '../data/profile.json';
import { local } from '../lib/paths';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter(p => p.data.featured);
const more = projects.filter(p => !p.data.featured);
---
<Layout>
  <header class="home-hero">
    <h1>AI for the way<br /><span>designers think.</span></h1>
    <div class="intro">{profile.about.map(p => <p><Emphasis text={p} /></p>)}</div>
    <div class="hero-links"><a class="text-link" href="#work">Selected work <span aria-hidden="true">↓</span></a><a class="quiet-link" href={local('cv/')}>View CV <span aria-hidden="true">↗</span></a></div>
  </header>
  <section id="work" class="section-block">
    <div class="section-heading"><h2>Selected work</h2></div>
    <div>{featured.map(project => <ProjectCard project={project} />)}</div>
    {more.length > 0 && <div class="additional-work"><h3>More projects</h3>{more.map(project => <a href={local(`projects/${project.id}/`)}>{project.data.title} <span>↗</span></a>)}</div>}
  </section>
  <section id="publications" class="section-block publication-section">
    <div class="section-heading"><h2>Publication</h2></div>
    <article class="publication"><span class="publication-year">2026</span><div><h3><a href={local('projects/vague-design-requests/#poster')}>Analyzing Types of Vague Degree Expressions and Designing a Classification Prompt for LLM-based Support Systems <span aria-hidden="true">↗</span></a></h3><p><strong>Jangwoo Park</strong>, Myungjin Kim, and Kyungsik Han</p><p class="muted">Korea Data Mining Society Summer Conference · Poster P2-23</p></div></article>
  </section>
  <section id="experience" class="section-block">
    <div class="section-heading"><h2>Research experience</h2></div>
    {profile.experience.map(item => <article class="experience-row"><p class="period">{item.period}</p><div><h3>{item.lab}</h3><p class="experience-role">{item.role} · {item.advisor}</p><p>{item.description}</p>{item.project && <a class="text-link small-link" href={local(`projects/${item.project}/`)}>Read about this work <span aria-hidden="true">↗</span></a>}</div></article>)}
  </section>
  <section class="education-strip"><h2>Education</h2><p><strong>{profile.degree}</strong><br />Second major in <strong>{profile.secondMajor}</strong></p><p class="muted">{profile.institution} · Expected {profile.expectedGraduation}</p></section>
  <section id="contact" class="contact-section"><h2>Contact</h2><a class="text-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></section>
</Layout>
