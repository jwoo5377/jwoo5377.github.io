---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ExpressionVisual from '../../components/ExpressionVisual.astro';
import { local } from '../../lib/paths';
export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({ params: { id: project.id }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
---
<Layout title={data.title} description={data.summary}>
  <header class="project-header">
    <a class="back-link" href={local('#work')}>← Selected work</a>
    <p class="eyebrow">{data.category} / {data.year}</p>
    <h1>{data.title}</h1>
    <p class="detail-subtitle">{data.subtitle}</p>
    <p class="detail-summary">{data.summary}</p>
    <dl class="project-meta"><div><dt>Role</dt><dd>{data.role}</dd></div><div><dt>When</dt><dd>{data.period}</dd></div><div><dt>Context</dt><dd>{data.context}</dd></div></dl>
  </header>
  {(data.hero || project.id === 'vague-design-requests') && <figure class="project-hero">
    {data.hero ? <Image src={data.hero} alt={data.heroAlt || data.title} width={1400} format="webp" loading="eager" /> : <ExpressionVisual />}
    {data.heroCaption && <figcaption>{data.heroCaption}</figcaption>}
  </figure>}
  <nav class="contents-nav" aria-label="On this page">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>
  <div class="prose"><Content /></div>
  {data.gallery.length > 0 && <section class="project-gallery" aria-label="Project images">{data.gallery.map(item => <figure><Image src={item.image} alt={item.alt} width={1400} format="webp" loading="lazy" /><figcaption>{item.caption}</figcaption></figure>)}</section>}
  {data.resources.length > 0 && <section class="resources"><h2>Materials</h2>{data.resources.map(item => <a class="text-link" href={item.href.startsWith('http') ? item.href : local(item.href)}>{item.label} ↗</a>)}</section>}
  <p class="project-credit">{data.credit}</p>
  {next.id !== project.id && <a class="next-project" href={local(`projects/${next.id}/`)}><span class="eyebrow">Next project</span><strong>{next.data.title} <span aria-hidden="true">↗</span></strong></a>}
</Layout>
