---
interface Props { text: string; }
const { text } = Astro.props;
// Keep emphasis selective; content stays plain text and is escaped by Astro.
const terms = [
  'Interior Architecture Design', 'Computer Science',
  'human–computer interaction', 'AI systems',
  'past decisions', 'reasoning', 'structured design requests',
  'intended change', 'inflatable units', 'existing apartments',
];
const pattern = new RegExp(`(${terms.join('|')})`, 'gi');
const parts = text.split(pattern);
---
{parts.map((part, index) => index % 2 ? <strong>{part}</strong> : part)}
