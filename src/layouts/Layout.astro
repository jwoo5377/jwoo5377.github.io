---
import '../styles/global.css';
import profile from '../data/profile.json';
import { local } from '../lib/paths';
interface Props { title?: string; description?: string; active?: 'home' | 'cv'; }
const { title, description = 'Jangwoo Park explores human–computer interaction and AI systems that support designers. Research, selected projects, and experience.', active = 'home' } = Astro.props;
const fullTitle = title ? `${title} — ${profile.name}` : `${profile.name} — HCI & Design`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={local('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <aside class="profile-sidebar">
        <a class="identity" href={local()} aria-label="Jangwoo Park, home">
          <span class="monogram" aria-hidden="true">jp<span>·</span></span>
          <span class="identity-text"><strong>{profile.name}</strong><span lang="ko">{profile.nameKo}</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href={local()} aria-current={active === 'home' && !title ? 'page' : undefined}>About</a>
          <a href={local('#work')}>Selected work</a>
          <a href={local('#experience')}>Experience</a>
          <a href={local('cv/')} aria-current={active === 'cv' ? 'page' : undefined}>CV</a>
        </nav>
        <div class="sidebar-contact">
          <a href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
          <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
      <div class="main-column">
        <main id="main"><slot /></main>
        <footer class="site-footer"><span>© {new Date().getFullYear()} {profile.name}</span><a href="#main">Back to top ↑</a></footer>
      </div>
    </div>
  </body>
</html>
